<text y="381"><tspan x="0" fill="#cccccc">└──────────────────────────────────────────────────────────────────────────────┘</tspan></text>
<g class="vz-data" fill="#ffffff" fill-opacity="0.0">
<circle class="vz-point" cx="48.0" cy="360.0" r="7" data-label="2024-01-01" data-value="1000"><title>2024-01-01: 1k</title></circle>
<circle class="vz-point" cx="340.0" cy="292.8" r="7" data-label="2024-04-01" data-value="1200"><title>2024-04-01: 1.2k</title></circle>
